/**
 * Records the site's voice lines locally with Kokoro (open-source, Apache-2.0,
 * https://huggingface.co/hexgrad/Kokoro-82M). Runs entirely on this computer:
 * no API, no account, no key. The model (~90 MB) downloads once into
 * node_modules on first run.
 *
 *   npm install                              (once, in tools/voice)
 *   npm run preview                          → previews/<voice>.wav, one sample per voice
 *   npm run render -- --voice=af_heart       → ../../public/voice/*.wav + lib/audio/voice-clips.json
 *
 * Options: --voice=<id>  --speed=<0.7–1.2>  --space=cosmic|room
 */
import { createHash } from "node:crypto";
import { mkdir, readdir, rm, writeFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { KokoroTTS } from "kokoro-js";
import { RECORDED_LINES, clipKey, spokenForm } from "../../lib/voice-lines.ts";
import { encodeWav, shapeVoice, type VoiceSpace } from "../../lib/audio/voice-shaping.ts";

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, "..", "..");
const args = Object.fromEntries(
  process.argv.slice(2).map((a) => {
    const [k, v] = a.replace(/^--/, "").split("=");
    return [k, v ?? "true"];
  })
);

const MODEL = "onnx-community/Kokoro-82M-v1.0-ONNX";
const speed = Number(args.speed ?? 0.92);
const space = (args.space ?? "cosmic") as VoiceSpace;
const PREVIEW_VOICES = ["af_heart", "af_nicole", "af_kore", "bf_emma"];
const PREVIEW_TEXT =
  "Welcome to Marbella. A place where extraordinary living meets timeless beauty. Discover your next chapter with Real Property Estate.";

console.log(`Loading Kokoro (${MODEL}, q8, CPU)…`);
const tts = await KokoroTTS.from_pretrained(MODEL, { dtype: "q8", device: "cpu" });

/**
 * Pronunciation fixes, applied only to what the voice reads (the site's text is
 * unchanged). Respellings chosen by checking Kokoro's phonemes for each.
 */
const PRONUNCIATION: [RegExp, string][] = [
  [/\bMarbella\b/g, "Mar-bay-ya"], // Spanish: mar-BAY-ya, not mar-BELL-a
  [/\bMassimo Michelino\b/g, "Mahssy-mo Meekeleeno"], // Italian: MAH-ssi-mo mee-keh-LEE-no
];

function forSpeech(text: string): string {
  return PRONUNCIATION.reduce((t, [pattern, sayAs]) => t.replace(pattern, sayAs), spokenForm(text));
}

async function record(text: string, voice: string) {
  const audio = await tts.generate(forSpeech(text), { voice: voice as never, speed });
  const { left, right } = shapeVoice(audio.audio, audio.sampling_rate, space);
  return { wav: encodeWav(left, right, audio.sampling_rate), seconds: left.length / audio.sampling_rate };
}

if (args.preview) {
  const outDir = join(here, "previews");
  await mkdir(outDir, { recursive: true });
  const voices = args.voice ? String(args.voice).split(",") : PREVIEW_VOICES;
  for (const voice of voices) {
    const { wav, seconds } = await record(PREVIEW_TEXT, voice);
    await writeFile(join(outDir, `${voice}-${space}.wav`), wav);
    console.log(`✓ previews/${voice}-${space}.wav  (${seconds.toFixed(1)} s)`);
  }
  process.exit(0);
}

const voice = String(args.voice ?? "af_heart");
const outDir = join(root, "public", "voice");
await mkdir(outDir, { recursive: true });
const clips: Record<string, string> = {};
const keep = new Set<string>();
let bytes = 0;

for (const [i, line] of RECORDED_LINES.entries()) {
  const id = createHash("sha1").update(`kokoro|${voice}|${speed}|${space}|${clipKey(line)}`).digest("hex").slice(0, 12);
  const file = `${id}.wav`;
  const { wav, seconds } = await record(line, voice);
  await writeFile(join(outDir, file), wav);
  clips[clipKey(line)] = `/voice/${file}`;
  keep.add(file);
  bytes += wav.length;
  console.log(`[${String(i + 1).padStart(2)}/${RECORDED_LINES.length}] ${seconds.toFixed(1)} s  ${line.slice(0, 60)}${line.length > 60 ? "…" : ""}`);
}

for (const f of await readdir(outDir)) {
  if (f.endsWith(".wav") && !keep.has(f)) await rm(join(outDir, f));
}

await writeFile(
  join(root, "lib", "audio", "voice-clips.json"),
  `${JSON.stringify(
    {
      note: "Generated by tools/voice (Kokoro, local) from lib/voice-lines.ts — do not edit by hand.",
      model: "Kokoro-82M v1.0 (Apache-2.0)",
      voice,
      settings: { speed, space },
      generatedAt: new Date().toISOString(),
      clips,
    },
    null,
    2
  )}\n`
);
console.log(`\nRecorded ${keep.size} lines (${(bytes / 1024 / 1024).toFixed(1)} MB) with ${voice}, ${space} space.`);
