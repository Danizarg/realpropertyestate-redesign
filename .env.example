NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OWNER_EMAIL=owner@example.com
NEXT_PUBLIC_SITE_URL=https://www.realpropertyestate.online

# Resend (https://resend.com) — sends an email to OWNER_EMAIL on every
# contact form / property enquiry submission. Without this set, submissions
# still save to Supabase but no email is sent.
RESEND_API_KEY=re_your_api_key
# Must be on a domain you've verified in Resend. Until then, leave unset to
# use Resend's shared onboarding@resend.dev sender (only deliverable to the
# email address your Resend account was signed up with).
RESEND_FROM_EMAIL=Real Property Estate <noreply@realpropertyestate.online>

# Optional — live concierge voice. Not needed for the intro or standard phrases:
# those are pre-recorded in public/voice/ (see README, "The voice"). With a key set
# here (server-side only), changing concierge replies are also spoken live in the
# same voice. Use your own OpenAI key. (OPENAI_API_KEY also works.)
# VOICE_TTS_API_KEY=sk-your-openai-key
# VOICE_TTS_VOICE=marin
# VOICE_TTS_MODEL=gpt-4o-mini-tts
#
# Alternative voice provider, used only when no key above is set:
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
